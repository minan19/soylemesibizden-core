// SÖYLEMESİ BİZDEN — Veri Modeli v2.0 · 28.07.2026 (TRT)
// Merkez varlık: TAŞINMAZ. İlan, taşınmaza bağlı bir kayıttır.
// Para: tam sayı KURUŞ (BigInt). Kayan nokta kullanılmaz.

// Tek istemci. v2 artik "ikinci sema" degil, YURURLUKTEKI semadir;
// yan yana tasima yapilmadigi icin ayri client-v2 ciktisina gerek yok.
// (Canli DB'de yalnizca 43 satir seed verisi vardi — gercek kullanici
// ve gercek ilan yoktu; bu yuzden temiz kesim secildi.)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KullaniciRol {
  BIREYSEL
  OFIS_YETKILISI
  OFIS_PERSONELI
  MODERATOR
  ADMIN
}

model Kullanici {
  id         String       @id @default(uuid())
  eposta     String       @unique
  parolaHash String?
  adSoyad    String?
  telefon    String?
  rol        KullaniciRol @default(BIREYSEL)

  eidsKullaniciKodu String?   @unique
  kimlikDogrulandi  Boolean   @default(false)
  kimlikDogrulamaTs DateTime?

  ofisId String?
  ofis   EmlakOfisi? @relation(fields: [ofisId], references: [id])

  eklendi     DateTime @default(now())
  guncellendi DateTime @updatedAt

  ilanlar            Ilan[]
  favoriler          Favori[]
  kayitliAramalar    KayitliArama[]
  gonderilenMesajlar Mesaj[]        @relation("Gonderen")
  alinanMesajlar     Mesaj[]        @relation("Alici")
  randevular         Randevu[]
  sikayetler         Sikayet[]

  @@index([ofisId])
  @@map("kullanici")
}

model EmlakOfisi {
  id       String @id @default(uuid())
  unvan    String
  mersisNo String @unique
  vergiNo  String

  yetkiBelgeNo      String   @unique
  yetkiBelgeBitis   DateTime
  yetkiBelgeGecerli Boolean  @default(false)

  ilTrafikKodu Int
  adres        String?
  telefon      String?

  eklendi     DateTime @default(now())
  guncellendi DateTime @updatedAt

  personel Kullanici[]
  ilanlar  Ilan[]

  @@index([yetkiBelgeGecerli])
  @@map("emlak_ofisi")
}

model Mahalle {
  id        String @id @default(uuid())
  ilKodu    Int
  ilAd      String
  ilceAd    String
  mahalleAd String

  ortalamaM2Kurus BigInt?
  endeksGuncelTs  DateTime?

  tasinmazlar Tasinmaz[]

  @@unique([ilKodu, ilceAd, mahalleAd])
  @@index([ilKodu])
  @@map("mahalle")
}

enum TasinmazTipi {
  KONUT
  ISYERI
  ARSA
  BINA
  DEVREMULK
}

model Tasinmaz {
  id String @id @default(uuid())

  // TAPU KİMLİĞİ — platformun omurgası.
  // Bir taşınmaz numarası = bir kart. Mükerrer ilan yapısal olarak imkânsız.
  tasinmazNo String       @unique
  tipi       TasinmazTipi

  ada             String?
  parsel          String?
  bagimsizBolumNo String?

  mahalleId String
  mahalle   Mahalle @relation(fields: [mahalleId], references: [id])

  enlem  Decimal? @db.Decimal(10, 7)
  boylam Decimal? @db.Decimal(10, 7)

  brutM2 Int?
  netM2  Int?

  eklendi     DateTime @default(now())
  guncellendi DateTime @updatedAt

  ilanlar  Ilan[]
  yetkiler EidsYetki[]

  @@index([mahalleId])
  @@index([tipi])
  @@map("tasinmaz")
}

enum YetkiTuru {
  MALIK
  HISIM
  YETKILI_ISLETME
}

enum YetkiDurumu {
  BEKLIYOR
  GECERLI
  SURESI_DOLDU
  IPTAL
}

enum YetkiKaynagi {
  GERCEK
  MOCK
}

model EidsYetki {
  id String @id @default(uuid())

  tasinmazId String
  tasinmaz   Tasinmaz @relation(fields: [tasinmazId], references: [id], onDelete: Cascade)

  turu   YetkiTuru
  durumu YetkiDurumu @default(BEKLIYOR)

  eidsKullaniciKodu String
  eidsReferansNo    String? @unique

  baslangic DateTime
  bitis     DateTime

  // Production'da MOCK kaynaklı yetkiyle ilan YAYINLANAMAZ.
  kaynak YetkiKaynagi @default(MOCK)

  eklendi     DateTime @default(now())
  guncellendi DateTime @updatedAt

  ilanlar Ilan[]

  @@index([tasinmazId, durumu])
  @@index([bitis])
  @@map("eids_yetki")
}

enum IlanDurumu {
  TASLAK
  YETKI_BEKLIYOR
  MODERASYONDA
  YAYINDA
  TEYIT_BEKLIYOR
  PASIF
  ARSIVLENDI
  REDDEDILDI
}

enum IlanTuru {
  SATILIK
  KIRALIK
}

model Ilan {
  id String @id @default(uuid())

  tasinmazId String
  tasinmaz   Tasinmaz @relation(fields: [tasinmazId], references: [id], onDelete: Cascade)

  yetkiId String
  yetki   EidsYetki @relation(fields: [yetkiId], references: [id])

  sahibiId String
  sahibi   Kullanici @relation(fields: [sahibiId], references: [id])

  ofisId String?
  ofis   EmlakOfisi? @relation(fields: [ofisId], references: [id])

  turu   IlanTuru
  durumu IlanDurumu @default(TASLAK)

  baslik   String
  aciklama String? @db.Text

  // PARA: tam sayı kuruş. Float ASLA kullanılmaz.
  fiyatKurus BigInt
  paraBirimi String @default("TRY")

  odaSayisi  String?
  binaYasi   Int?
  kat        Int?
  isitmaTipi String?
  esyali     Boolean @default(false)
  aidatKurus BigInt?

  // CANLILIK TEYİDİ — hayalet ilan sorununun çözümü
  sonTeyitTs      DateTime?
  teyitSonTarih   DateTime?
  otomatikPasifTs DateTime?

  yayinTs      DateTime?
  goruntulenme Int       @default(0)

  eklendi     DateTime @default(now())
  guncellendi DateTime @updatedAt

  medyalar     Medya[]
  fiyatGecmisi FiyatGecmisi[]
  favoriler    Favori[]
  mesajlar     Mesaj[]
  randevular   Randevu[]
  sikayetler   Sikayet[]

  @@index([durumu, yayinTs])
  @@index([tasinmazId])
  @@index([sahibiId])
  @@index([teyitSonTarih])
  @@map("ilan")
}

model FiyatGecmisi {
  id     String @id @default(uuid())
  ilanId String
  ilan   Ilan   @relation(fields: [ilanId], references: [id], onDelete: Cascade)

  // Kalıcı ve herkese açık. Silinmez.
  eskiFiyatKurus BigInt?
  yeniFiyatKurus BigInt
  degisimTs      DateTime @default(now())

  @@index([ilanId, degisimTs])
  @@map("fiyat_gecmisi")
}

model Medya {
  id     String @id @default(uuid())
  ilanId String
  ilan   Ilan   @relation(fields: [ilanId], references: [id], onDelete: Cascade)

  url  String
  sira Int    @default(0)

  // MÜKERRER GÖRSEL TESPİTİ — her ikisi de SUNUCUDA hesaplanır.
  // İstemciden gelen hash'e güvenilmez; güven özelliği olmasının anlamı bu.
  //
  // icerikHash: SHA-256, birebir aynı dosya. Ucuz ve kesin.
  // algiHash  : dHash, görsel olarak aynı. Yeniden boyutlandırma,
  //             sıkıştırma ve hafif düzenlemeye dayanıklı.
  icerikHash     String?
  algiHash       String?
  yapayZekaSuphe Int?

  // KÖKEN BEYANI — dosyanın üstverisinden okunur, TAHMİN EDİLMEZ.
  // Piksel analiziyle "bu YZ ürünü" demek güvenilir değil; yanlış
  // pozitif masum bir ilan sahibini damgalar. Bunun yerine C2PA
  // imzası, XMP araç beyanı ve EXIF kamera bilgisi kaydedilir.
  kokenIsaretleri String[] @default([])
  kokenAraci      String?
  kameraMarka     String?
  cekimTarihi     String?

  eklendi DateTime @default(now())

  @@index([ilanId, sira])
  @@index([algiHash])
  @@index([icerikHash])
  @@map("medya")
}

model Favori {
  id          String    @id @default(uuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  ilanId      String
  ilan        Ilan      @relation(fields: [ilanId], references: [id], onDelete: Cascade)
  eklendi     DateTime  @default(now())

  @@unique([kullaniciId, ilanId])
  @@map("favori")
}

model KayitliArama {
  id          String    @id @default(uuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  ad            String
  kriterler     Json
  bildirimAcik  Boolean   @default(true)
  sonBildirimTs DateTime?

  eklendi DateTime @default(now())

  @@index([kullaniciId])
  @@map("kayitli_arama")
}

model Mesaj {
  id     String @id @default(uuid())
  ilanId String
  ilan   Ilan   @relation(fields: [ilanId], references: [id], onDelete: Cascade)

  gonderenId String
  gonderen   Kullanici @relation("Gonderen", fields: [gonderenId], references: [id])
  aliciId    String
  alici      Kullanici @relation("Alici", fields: [aliciId], references: [id])

  icerik  String   @db.Text
  okundu  Boolean  @default(false)
  eklendi DateTime @default(now())

  @@index([ilanId])
  @@index([aliciId, okundu])
  @@map("mesaj")
}

enum RandevuDurumu {
  TALEP
  ONAYLANDI
  GERCEKLESTI
  IPTAL
  GELMEDI
}

model Randevu {
  id     String @id @default(uuid())
  ilanId String
  ilan   Ilan   @relation(fields: [ilanId], references: [id], onDelete: Cascade)

  talepEdenId String
  talepEden   Kullanici @relation(fields: [talepEdenId], references: [id])

  durumu RandevuDurumu @default(TALEP)
  tarih  DateTime

  // Gösterim sonrası doğrulama — yem ilan tespiti
  ilanGercekMi Boolean?
  notlar       String?  @db.Text

  eklendi DateTime @default(now())

  @@index([ilanId, tarih])
  @@map("randevu")
}

enum SikayetTuru {
  SATILDI_HALA_YAYINDA
  YANLIS_FIYAT
  YANLIS_KONUM
  YEM_ILAN
  SAHTE_GORSEL
  YETKISIZ_ILAN
  DIGER
}

model Sikayet {
  id     String @id @default(uuid())
  ilanId String
  ilan   Ilan   @relation(fields: [ilanId], references: [id], onDelete: Cascade)

  bildirenId String
  bildiren   Kullanici @relation(fields: [bildirenId], references: [id])

  turu     SikayetTuru
  aciklama String?     @db.Text

  // SLA şeffaflığı — kaç saatte kapandığı ofis profilinde görünür
  acilisTs  DateTime  @default(now())
  kapanisTs DateTime?
  sonuc     String?

  @@index([ilanId])
  @@index([kapanisTs])
  @@map("sikayet")
}
